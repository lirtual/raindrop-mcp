{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raindrop-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "observability": {
    "enabled": true
  },
  "vars": {
    "RAINDROP_RATE_LIMIT_POINTS": "30",
    "RAINDROP_RATE_LIMIT_DURATION_SECONDS": "60",
    "RAINDROP_RATE_LIMIT_MAX_RETRIES": "3"
  }
}
